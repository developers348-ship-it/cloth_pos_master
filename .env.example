# --- Provider Toggle ---------------------------------------------------------
# Controls which database backend the app connects to.
# Options: "local" | "supabase"
DB_PROVIDER="local"

# --- Local PostgreSQL --------------------------------------------------------
# Used when DB_PROVIDER="local"
# Standard PostgreSQL connection string for a locally running instance.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clothPos"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/clothPos"

# --- Supabase ----------------------------------------------------------------
# Used when DB_PROVIDER="supabase"
# Get all values from: https://supabase.com/dashboard -> Your Project -> Settings

# Database -> Connection string -> Transaction pooler (port 6543)
# Required for Prisma in serverless/edge environments (pgbouncer=true)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Database -> Connection string -> Direct connection (port 5432)
# Required for prisma migrate / prisma db push
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-xx.pooler.supabase.com:5432/postgres"

# API -> Project URL
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# API -> anon / public key (safe to expose in browser)
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# API -> service_role key (keep secret! server-side only)
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- NextAuth ----------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Base URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# --- Test data tools ----------------------------------------------------------
# Kill switch for Settings -> Clear Data (wipe transactional data for a fresh
# round of testing, with an automatic one-click-restorable backup first).
# Must be exactly "true" to turn it on; unset or "false" hides the whole tab
# and 404s its API routes. Leave unset (or "false") on a client's install —
# set to "true" only on your own dev/test database.
ENABLE_TEST_DATA_TOOLS="false"
