/*
  ts-node config for the scripts in this folder.

  It keeps `{"module":"CommonJS"}` in a project file instead of passing it as
  inline JSON, which PowerShell can mangle before ts-node receives it.

  `baseUrl` and `paths` are inherited from the root config, which is where
  `tsconfig-paths/register` reads them from — reset-data.ts imports the app's
  own backup engine through `@/…`, so the alias has to resolve.
*/
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false
  },
  "include": ["./**/*.ts"]
}
